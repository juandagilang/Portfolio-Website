---
import SectionHeading from './SectionHeading.astro'

const timeline = [
  {
    period: 'Jul – Aug 2024',
    role: 'Backend Developer · Internship',
    place: 'Paroki Tanjung Priok',
    blurb:
      'Designed a MySQL database with 10+ relational tables, built a CodeIgniter 4 CMS and interactive admin dashboard, and cut data retrieval by 25% and content updates by 40%.',
  },
  {
    period: 'Jan – Jun 2024',
    role: 'Flutter Developer · Team Lead',
    place: 'TechCare (Hackfest)',
    blurb:
      'Led a 4-person team building TechCare, a device repair-service app, and shipped 100% of planned features using Agile daily stand-ups to keep everyone aligned.',
  },
  {
    period: 'Feb 2024',
    role: 'Frontend Engineer · Freelance',
    place: 'Megatama Global International',
    blurb:
      'Built a responsive company-profile website with ReactJS and Tailwind CSS, delivered in under 48 hours.',
  },
  {
    period: 'Aug – Dec 2023',
    role: 'Machine Learning Cohort',
    place: 'Bangkit Academy',
    blurb:
      'Built a TensorFlow model that identifies food nutrients at 85% accuracy and a Kotlin app with 20% lower navigation latency, launched Fitforma with a 5-person team.',
  },
  {
    period: 'Sep 2021 – Feb 2025',
    role: 'Information Technology Student',
    place: 'Institute of Business and Informatics Kwik Kian Gie',
    blurb:
      'Graduated in Information Technology with a GPA of 3.81, the foundation for the backend work I do today.',
  },
]
---

<section id="journey" class="border-y border-line bg-paper/60 py-24">
  <div class="mx-auto max-w-5xl px-6 sm:px-8">
    <SectionHeading title="A short trail through the years." />

    <ol class="relative space-y-12 border-l border-line pl-8 sm:pl-12">
      {timeline.map((item) => (
        <li class="reveal relative">
          <span class="absolute -left-[41px] top-1.5 h-3 w-3 rounded-full border-2 border-ember-500 bg-cream-100 sm:-left-[57px]"></span>
          <span class="kicker">{item.period}</span>
          <h3 class="mt-2 font-display text-2xl font-semibold text-ink-900">{item.role}</h3>
          <p class="mt-1 text-sm font-medium text-ember-600">{item.place}</p>
          <p class="mt-3 max-w-2xl leading-relaxed text-ink-700">{item.blurb}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
