---
const socialLink = (label, href) => ({ label, href })
---

<section id="top" class="relative flex min-h-[100svh] items-center justify-center overflow-hidden px-6 pt-24 pb-20 sm:px-8">
  <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-ember-100 blur-3xl opacity-70"></div>
  <div class="absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-olive-500/20 blur-3xl"></div>

  <div class="relative mx-auto max-w-3xl text-center">
    <h1 class="reveal font-display text-5xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-7xl">
      BACKEND ENGINEER
    </h1>

    <p class="reveal mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-700 sm:text-xl">
      I build <span class="font-medium text-ember-600">fast, dependable backends</span> in Go and PHP.
      REST APIs people actually enjoy consuming, backed by PostgreSQL and MySQL, plus the details everyone else skips.
    </p>

    <div class="reveal mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="#work" class="rounded-full bg-ink-900 px-8 py-3.5 font-medium text-cream-50 transition-colors hover:bg-ember-600">
        See the work I've done
      </a>
      <a href="#contact" class="rounded-full border border-ink-900/30 px-8 py-3.5 font-medium text-ink-900 transition-colors hover:border-ember-600 hover:text-ember-600">
        Get in touch
      </a>
    </div>

    <div class="reveal mt-14 flex items-center justify-center gap-6 text-ink-500">
      <span class="h-px w-12 bg-line"></span>
      <p class="text-sm tracking-wide">Open to backend roles</p>
      <span class="h-2 w-2 rounded-full bg-olive-600"></span>
      <span class="hidden sm:block h-px w-12 bg-line"></span>
    </div>
  </div>
</section>
