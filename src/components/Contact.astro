---
const contact = [
  { label: 'Email', value: 'juandagilang7@gmail.com', href: 'mailto:juandagilang7@gmail.com' },
  { label: 'GitHub', value: 'github.com/juandagilang', href: 'https://github.com/juandagilang' },
  { label: 'LinkedIn', value: 'in/juanda-gilang', href: 'https://www.linkedin.com/in/juanda-gilang/' },
]
---

<section id="contact" class="border-t border-line bg-paper py-24">
  <div class="mx-auto max-w-3xl px-6 text-center sm:px-8">
    <h2 class="reveal font-display text-4xl font-semibold tracking-tight text-ink-900 sm:text-5xl">
      Have a system worth building?
    </h2>
    <p class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-700">
      If you're after a backend that's fast, dependable, and a pleasure to maintain, I'd love to hear about it.
      Tell me what you're building, and I'll tell you honestly how I can help.
    </p>

    <a href="mailto:juandagilang7@gmail.com" class="reveal mt-10 inline-block rounded-full bg-ember-600 px-10 py-4 font-medium text-cream-50 transition-colors hover:bg-ink-900">
      Drop me a line
    </a>

    <ul class="reveal mt-12 flex flex-col items-center justify-center gap-4 text-sm sm:flex-row sm:gap-12">
      {contact.map((c) => (
        <li>
          <a href={c.href} class="group flex flex-col items-center gap-1" target="_blank" rel="noopener">
            <span class="uppercase tracking-widest text-xs text-ink-500">{c.label}</span>
            <span class="font-medium text-ink-900 transition-colors group-hover:text-ember-600">{c.value}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
